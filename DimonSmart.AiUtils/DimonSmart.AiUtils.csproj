<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configuration>Release</Configuration>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>DimonSmart.AiUtils - LLM Response Processing Utilities</Title>
    <Description>A comprehensive library for processing and extracting structured content from Large Language Model (LLM) responses. Features include JSON extraction from mixed text responses, think tag parsing to separate reasoning from answers, and robust handling of malformed or embedded JSON data. Essential for AI applications that need to parse LLM outputs reliably.</Description>
    <Authors>DimonSmart</Authors>
    <Company>DimonSmart</Company>
    <PackageProjectUrl>https://github.com/DimonSmart/AI.Utils</PackageProjectUrl>
    <PackageIcon>ai_utils.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/DimonSmart/AI.Utils</RepositoryUrl>
    <PackageTags>LLM;AI;JSON;Parser;Extractor;ChatGPT;OpenAI;Claude;ResponseProcessing;TextParsing;ThinkTags;MachineLearning;NLP;AIUtils;ContentExtraction;StructuredData;LargeLanguageModel;AIResponse;JSONExtraction;ThoughtProcess;ReasoningExtraction</PackageTags>
    <PackageLicenseExpression>0BSD</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PackageVersion>1.$([System.DateTime]::UtcNow.ToString("yyMdd")).$([System.DateTime]::UtcNow.ToString("HHmm"))</PackageVersion>
    <Version>1.$([System.DateTime]::UtcNow.ToString("yyMdd")).$([System.DateTime]::UtcNow.ToString("HHmm"))</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="/" />
    <None Include="ai_utils.png" Pack="True" PackagePath="/" />
  </ItemGroup>

</Project>
